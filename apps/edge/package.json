{
  "name": "@hyperion/cerberus-edge-shell",
  "version": "0.2.0",
  "private": true,
  "description": "Cerberus Edge evidence and gateway operator application",
  "author": "Hyperion Industries",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64",
    "package:pi": "npm run build && electron-builder --linux AppImage --arm64",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.50.0",
    "@xyflow/react": "^12.12.1",
    "d3-geo": "^3.1.2",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.hyperion.cerberus.edge",
    "productName": "Cerberus Edge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
